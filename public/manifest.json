{
  "manifest_version": 3,
  "name": "Shadow",
  "version": "0.1.0",
  "description": "Your shadow companion. Always watching. Always with you.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["shadow.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {},
  "web_accessible_resources": [
    {
      "resources": ["*.js", "*.css", "*.png", "*.svg", "*.splinecode", "*.glb"],
      "matches": ["<all_urls>"]
    }
  ]
}